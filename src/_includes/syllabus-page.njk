---
layout: base.njk
---
<link rel="stylesheet" href="/assets/css/syllabus.css" />
<main class="col-sm-9 syllabus-page">
  <div class="syllabus-toolbar">
    <button type="button" class="syllabus-print" onclick="window.print()">
      <i class="fas fa-print" aria-hidden="true"></i> Print / Save as PDF
    </button>
  </div>
  <div class="syllabus-layout">
    <aside class="syllabus-toc">{{ content | toc | safe }}</aside>
    <article class="syllabus-body">{{ content | headingIds | safe }}</article>
  </div>
</main>
